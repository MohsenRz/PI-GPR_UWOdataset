[CONTROLS]
;;Control Rules
;;Control Rules
;;Control Rules
;;Control Rules
;;Control Rules
;;Control Rules
;;Control Rules
;;Control Rules
RULE Pumpe_PW80_Industrie_OFF
IF LINK Link_2 FLOW > 160
THEN PUMP PW80_Industrie STATUS = OFF

RULE Entleerungspumpe_FB_ARA_ON
IF NODE FB_ARA DEPTH > 0.25
AND LINK Link_2 FLOW < 160
THEN PUMP EntleerungspumpeFBARA STATUS = ON

RULE Entleerungspumpe_RB_59_ON
IF NODE RB_59 DEPTH > 0.4
AND LINK Link_2 FLOW < 170
THEN PUMP EntleerungspumpeRB59 STATUS = ON

RULE Entleerungspumpe_Usterstrasse_ON
IF NODE RÜB_Usterstrasse DEPTH > 0.7
AND LINK HAL157 FLOW < 95
THEN PUMP EntleerungspumpeRÜBUsterstrasse STATUS = ON







